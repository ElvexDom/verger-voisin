# .env.example : modèle de configuration de Verger Voisin
#
# Ce fichier est suivi par Git. Il ne contient QUE des noms de variables (et quelques
# réglages non sensibles). Aucune valeur secrète ne doit jamais y être écrite.
#
# Utilisation :
#   1. copie-le :            cp .env.example .env
#      (scripts/installer.sh le fait pour toi s'il manque)
#   2. remplis .env sur le serveur (le vrai .env n'est jamais commité : il est dans .gitignore)
#   3. vérifie qu'il est bien ignoré : git status ne doit pas le lister
#
# Ce fichier est lu par Docker Compose (compose.yaml) et par les scripts du dépôt.
# Format attendu :
#   - une variable par ligne, sous la forme NOM=valeur, sans espace autour du signe =
#   - pas de commentaire sur la même ligne qu'une valeur (les commentaires ont leur propre ligne)
#   - pas de guillemets, et pas de signe $ dans les valeurs (Docker Compose le lirait comme
#     une variable à remplacer)
#   - une valeur laissée vide veut dire « non renseignée » ou « valeur par défaut », selon la
#     variable (c'est dit à chaque fois)

# ---------------------------------------------------------------------------
# Docker : projet, images et utilisateur du conteneur
# ---------------------------------------------------------------------------
# Nom du projet Docker Compose (préfixe des conteneurs, du réseau et des volumes).
COMPOSE_PROJECT_NAME=verger-voisin
# Image de la base PostgreSQL. HYPOTHÈSE À VÉRIFIER sur le serveur : l'étiquette existe sur
# Docker Hub. Ne change pas de version majeure sur une base déjà créée sans migrer les données.
IMAGE_POSTGRES=postgres:17-bookworm
# Image de base de l'environnement de travail (Python). HYPOTHÈSE À VÉRIFIER sur le serveur :
# l'étiquette existe et sa version de Python est acceptée par PySpark.
IMAGE_PYTHON=python:3.12-slim-trixie
# Paquet Java installé dans l'image de travail (apt de l'image Python ci-dessus).
# HYPOTHÈSE À VÉRIFIER : le paquet existe dans ce système et sa version est acceptée par PySpark
# (compatibilité à vérifier dans la documentation de la version de PySpark installée).
JAVA_PAQUET=openjdk-21-jre-headless
# Nom donné à l'image de travail construite localement.
IMAGE_TRAVAIL=verger-voisin-travail:local
# Identifiants de l'utilisateur du conteneur de travail. Laisse VIDE : scripts/installer.sh les
# remplit avec ceux de ton utilisateur du serveur (ce ne sont pas des secrets). Ils servent à
# ce que le conteneur puisse écrire dans les dossiers de données et de journaux.
CONTENEUR_UID=
CONTENEUR_GID=

# ---------------------------------------------------------------------------
# PostgreSQL (la base tourne dans un conteneur, jamais publiée sur Internet)
# ---------------------------------------------------------------------------
# Nom de la base, créée au premier démarrage. Lettres minuscules, chiffres et _ seulement.
# Choix à décider.
POSTGRES_DB=
# Nom de l'utilisateur de la base. Mêmes règles. Choix à décider.
# Attention : ces deux noms sont fixés à la création de la base (premier démarrage).
POSTGRES_USER=
# SECRET. Mot de passe de cet utilisateur. À choisir et à remplir seulement dans .env.
# Seulement des lettres, des chiffres et les symboles . _ + = : , - (pas de $, de guillemets,
# de # ni d'espace) : Docker Compose les lirait de travers.
POSTGRES_PASSWORD=
# Le conteneur de travail joint la base par le nom de son service Compose ("postgres") et son
# port interne : POSTGRES_HOST et POSTGRES_PORT sont réglés dans compose.yaml, pas ici.
# Facultatif, seulement avec compose.acces-hote.yaml : port local (127.0.0.1) de l'hôte.
# Vide = 5432.
POSTGRES_PORT_HOTE=

# ---------------------------------------------------------------------------
# Java et Spark (mode local, dans le conteneur de travail)
# ---------------------------------------------------------------------------
# Mémoire maximale donnée à Spark, par exemple 512m ou 2g (ce ne sont que des exemples de
# format, pas une recommandation chiffrée). La mémoire du serveur est partagée entre Spark,
# PostgreSQL et l'API : valeur à décider après un essai.
SPARK_DRIVER_MEMORY=
# Nombre de cœurs utilisés par Spark. Facultatif : vide = tous les cœurs du serveur.
SPARK_NB_COEURS=

# ---------------------------------------------------------------------------
# API Open Food Facts
# ---------------------------------------------------------------------------
# Adresse de base de l'API, au format https://nom-de-l-hote (sans / à la fin).
# Valeur non secrète, vérifiée le 2026-10-19 (réponse HTTP 200 de l'API).
OFF_API_BASE_URL=https://world.openfoodfacts.org
# Nom de l'application, utilisé dans le User-Agent envoyé à Open Food Facts.
OFF_APP_NOM=verger-voisin
# Lien vers le dépôt GitHub du projet, utilisé dans le User-Agent.
# Le User-Agent est construit ainsi : "NOM (LIEN)". Ne mets AUCUNE adresse e-mail
# (ni ici ni dans le nom) : une adresse personnelle serait une donnée personnelle.
OFF_APP_LIEN_DEPOT=https://github.com/ElvexDom/verger-voisin
# Code-barres (chiffres seulement) d'un produit connu d'Open Food Facts, utilisé par le
# contrôle pour faire un seul appel de test. Valeur non secrète, vérifiée le 2026-10-19
# (produit trouvé par l'API) ; tu peux la remplacer par un autre code-barres connu.
OFF_CODE_BARRES_TEST=3017620422003

# ---------------------------------------------------------------------------
# Emplacements des fichiers SUR LE SERVEUR (jamais dans Git)
# ---------------------------------------------------------------------------
# Dossier du serveur monté dans le conteneur comme /donnees (export Open Food Facts, Parquet,
# sorties). Conseillé : un chemin absolu HORS du dépôt, par exemple /home/<utilisateur>/
# verger-voisin-donnees. Par défaut : le dossier "donnees/" du dépôt, dont le contenu est
# ignoré par Git. Un chemin relatif est calculé depuis la racine du dépôt ; n'utilise pas ~.
# Dans le conteneur, la variable DONNEES_DIR vaut toujours /donnees (réglé par compose.yaml).
DONNEES_HOTE=./donnees
# Dossier du serveur monté comme /journaux. Même principe, par défaut "journaux/" du dépôt.
JOURNAUX_HOTE=./journaux

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------
# Niveau : DEBUG, INFO, WARNING, ERROR ou CRITICAL. Garde INFO pour retrouver les lignes
# du contrôle de bon fonctionnement.
LOG_LEVEL=INFO
# Format des lignes de journal : "texte" (lisible) ou "json" (une ligne JSON par événement).
LOG_FORMAT=texte
